# ── TicketSense environment (backend) ────────────────────────────────────
# Copy to `.env` (repo root or backend/) and fill in. EVERYTHING IS OPTIONAL —
# the app runs fully offline using local TF-IDF embeddings + a deterministic
# heuristic reasoner. Set OPENAI_API_KEY to upgrade to real embeddings + LLM
# reasoning.
#
# Frontend vars live separately in frontend/.env.example (VITE_API_URL).

# Server
PORT=3001

# Data files (relative to backend/)
DATA_DIR=data
# These are generated by `npm run data:build`:
#   backend/data/store.json      — corpus + evidence ledger + eval metrics
#   backend/data/index_meta.json — embedder metadata (idf table, dims)

# ── OpenAI (optional) ────────────────────────────────────────────────────
# Leave blank to use the offline local embedder + heuristic reasoner.
# NOTE: if this is set during `npm run data:build`, the index is built with
# OpenAI embeddings (1 API call). Keep it EMPTY at build time on hosts where
# outbound OpenAI access is blocked, so the build falls back to local cleanly.
OPENAI_API_KEY=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
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Confidence gating ─────────────────────────────────────────────────────
# Tickets with confidence >= this AND not high-risk are auto-routed.
AUTO_ROUTE_THRESHOLD=0.75

# Local embedding dimensionality (used only in offline mode)
EMBED_DIM=1024

# ── Database (optional) ──────────────────────────────────────────────────
# Leave blank to use the built-in JSON file store (backend/data/store.json).
# If set, TicketSense mirrors the corpus + evidence ledger into MongoDB.
# IMPORTANT for production deploys: the JSON store on a host like Render is
# EPHEMERAL (wiped on every deploy/restart) — set MONGODB_URI for persistence.
MONGODB_URI="mongodb+srv://gshreeskandaupadya_db_user:QwkChJzz0fSlVgDl@cluster0.rhoc1ux.mongodb.net"

# Frontend dev server (for CORS during local development)
CLIENT_ORIGIN=http://localhost:5173
