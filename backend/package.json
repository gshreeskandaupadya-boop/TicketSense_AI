{
  "name": "ticketsense-backend",
  "version": "1.0.0",
  "description": "TicketSense backend — Express REST API, decision pipeline, evidence ledger",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
