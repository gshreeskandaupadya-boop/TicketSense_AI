# TicketSense frontend (Vite). Copy to `.env.local` and fill in.

# Base URL of the deployed backend API — REQUIRED when the frontend is hosted
# separately (e.g. Vercel). Example: https://ticketsense.onrender.com
# Baked in at BUILD time. Leave empty when the backend serves this SPA
# (single-service deploy) or in local dev (Vite proxies /api to :3001).
VITE_API_URL=https://ticketsense-ai.onrender.com
